---
import { getLocale, localizedPath, translate } from '@/lib/i18n';

interface Props {
  placement: 'desktop' | 'bottom';
}
const { placement } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = translate(locale);
const home = localizedPath('/', locale);
const onProjects = localizedPath(Astro.url.pathname, 'en').startsWith('/projects');
const items = [
  {
    key: 'experience',
    label: t('Experience', 'Pengalaman'),
    href: `${home}#experience`,
    icon: 'M4 7h16v13H4z M8 7V4h8v3 M4 12h16 M10 12v3h4v-3',
  },
  {
    key: 'work',
    label: t('Work', 'Proyek'),
    href: onProjects ? localizedPath('/projects/', locale) : `${home}#work`,
    icon: 'M3 4h7v7H3z M14 4h7v7h-7z M3 15h7v6H3z M14 15h7v6h-7z',
  },
  {
    key: 'about',
    label: t('About', 'Tentang'),
    href: `${home}#about`,
    icon: 'M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0 M4 21v-2a8 8 0 0 1 16 0v2',
  },
  {
    key: 'contact',
    label: t('Contact', 'Kontak'),
    href: `${home}#contact`,
    icon: 'M4 5h16v12H9l-5 4z M8 9h8 M8 13h5',
  },
];
---

<nav
  class:list={[
    'site-navigation',
    `navigation-${placement}`,
    { 'glass-surface': placement === 'bottom' },
  ]}
  aria-label={t('Main navigation', 'Navigasi utama')}
>
  {
    items.map((item) => (
      <a
        href={item.href}
        data-nav-section={item.key}
        aria-current={item.key === 'work' && onProjects ? 'location' : undefined}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={item.icon} />
        </svg>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>

<script>
  import '@/scripts/active-navigation';
</script>

<style>
  .site-navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }
  a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.6rem clamp(0.6rem, 1.2vw, 1rem);
    border-radius: 999px;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.8rem;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  a:hover,
  a[aria-current] {
    color: var(--color-text);
    background: var(--glass-selected);
  }
  a[aria-current] {
    box-shadow: inset 0 1px 0 var(--glass-highlight);
  }
  svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  .navigation-desktop svg,
  .navigation-bottom {
    display: none;
  }
  @media (max-width: 1024px) {
    .navigation-desktop {
      display: none;
    }
    .navigation-bottom {
      position: fixed;
      z-index: 40;
      bottom: 0.75rem;
      left: 0.75rem;
      right: 0.75rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
      left: max(0.75rem, env(safe-area-inset-left, 0px));
      right: max(0.75rem, env(safe-area-inset-right, 0px));
      max-width: 520px;
      margin-inline: auto;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 0.4rem;
      border-radius: 28px;
    }
    .navigation-bottom a {
      flex-direction: column;
      gap: 0.3rem;
      min-height: 56px;
      padding: 0.4rem 0.15rem;
      border-radius: 21px;
      font-size: 0.75rem;
      font-weight: 550;
    }
    .navigation-bottom a:focus-visible {
      outline-offset: -2px;
    }
  }
</style>
