---
import type { Breadcrumb } from '@/lib/seo';

interface Props {
  items: Breadcrumb[];
  label: string;
}
const { items, label } = Astro.props;
---

<nav aria-label={label}>
  <ol>
    {
      items.map((item, index) => (
        <li>
          {index > 0 && (
            <span class="separator" aria-hidden="true">
              /
            </span>
          )}
          {index === items.length - 1 ? (
            <span aria-current="page">{item.name}</span>
          ) : (
            <a href={item.path}>{item.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* Match link spacing so the current page shares the same text baseline. */
  a,
  [aria-current='page'] {
    min-width: 0;
    padding-block: 0.5rem;
  }
  a {
    text-underline-offset: 0.2em;
  }
  .separator {
    flex-shrink: 0;
    opacity: 0.6;
  }
</style>
