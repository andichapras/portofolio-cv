---
const onPlayground = Astro.url.pathname.startsWith('/playground');
---

<header class="site-header container">
  <a class="brand" href="/" aria-label="andichapras — Home"
    ><span class="brand-mark" aria-hidden="true">a<span>.</span></span><span>andichapras</span></a
  >
  <nav aria-label="Main navigation">
    <a href="/#work">Work</a>
    <a href="/#about">About</a>
    <a href="/playground/" aria-current={onPlayground ? 'page' : undefined}
      >Playground <span class="nav-dot" aria-hidden="true"></span></a
    >
  </nav>
  <div class="header-actions">
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Dark mode"
      aria-pressed="true"
    >
      <span class="theme-toggle-track" aria-hidden="true">
        <svg class="theme-toggle-icon theme-toggle-track-sun" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
          ></path>
        </svg>
        <svg class="theme-toggle-icon theme-toggle-track-moon" viewBox="0 0 24 24">
          <path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"></path>
        </svg>
        <span class="theme-toggle-thumb">
          <svg class="theme-toggle-icon theme-toggle-thumb-sun" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
            ></path>
          </svg>
          <svg class="theme-toggle-icon theme-toggle-thumb-moon" viewBox="0 0 24 24">
            <path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"></path>
          </svg>
        </span>
      </span>
    </button>
    <a class="contact-link" href="/#contact">Let's talk <span aria-hidden="true">↗</span></a>
  </div>
</header>
<script>
  import '@/scripts/theme';
</script>
<style>
  .site-header {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .brand {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 650;
  }
  .brand-mark {
    font-size: 2.3rem;
    line-height: 1;
    letter-spacing: -0.15em;
    margin-right: 0.2rem;
  }
  .brand-mark span {
    color: var(--color-lime);
  }
  nav {
    display: flex;
    gap: 2rem;
  }
  nav a,
  .contact-link {
    font-size: 0.82rem;
    text-decoration: none;
    padding-block: 0.7rem;
  }
  nav a {
    color: var(--color-muted);
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--color-text);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .theme-toggle {
    --toggle-width: 78px;
    --toggle-height: 38px;
    --toggle-thumb-size: 32px;
    --toggle-shift: 40px;
    display: none;
    position: relative;
    width: var(--toggle-width);
    height: 44px;
    flex: 0 0 var(--toggle-width);
    padding: 0;
    border: 0;
    background: transparent;
    color: #c9d2ed;
  }
  :global(html.theme-controls-ready) .theme-toggle {
    display: block;
  }
  .theme-toggle-track {
    position: absolute;
    isolation: isolate;
    top: 50%;
    left: 0;
    width: 100%;
    height: var(--toggle-height);
    overflow: hidden;
    border: 1px solid #3a435d;
    border-radius: 999px;
    background:
      radial-gradient(circle at 28% 30%, #ffffffb3 0 1px, transparent 1.5px),
      radial-gradient(circle at 38% 68%, #ffffff80 0 1px, transparent 1.5px),
      radial-gradient(circle at 18% 72%, #ffffff66 0 1px, transparent 1.5px),
      linear-gradient(135deg, #151b2d, #303a5b);
    box-shadow:
      inset 0 1px 2px #ffffff12,
      0 7px 18px #0000002e;
    transform: translateY(-50%);
    transition:
      border-color 320ms ease,
      box-shadow 320ms ease;
  }
  .theme-toggle-track::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse at 32% 92%, #ffffffd9 0 12px, transparent 13px),
      radial-gradient(ellipse at 64% 95%, #ffffffa6 0 10px, transparent 11px),
      linear-gradient(145deg, #75c8f2, #c8e9f4);
    opacity: 0;
    transition: opacity 360ms ease !important;
  }
  .theme-toggle:hover .theme-toggle-track {
    border-color: var(--color-accent);
  }
  .theme-toggle-icon {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-toggle-track > .theme-toggle-icon {
    position: absolute;
    z-index: 1;
    top: 10px;
    width: 16px;
    height: 16px;
    opacity: 0.48;
    transition:
      color 280ms ease,
      opacity 280ms ease;
  }
  .theme-toggle-track-sun {
    left: 10px;
    color: #f6ce66;
  }
  .theme-toggle-track-moon {
    right: 10px;
    color: #dce4ff;
  }
  .theme-toggle-thumb {
    position: absolute;
    z-index: 2;
    top: 2px;
    left: 2px;
    width: var(--toggle-thumb-size);
    height: var(--toggle-thumb-size);
    border: 1px solid #46506b;
    border-radius: 50%;
    background-color: #252c42;
    box-shadow:
      0 5px 12px #080b1666,
      inset 0 1px 1px #ffffff1f;
    transform: translateX(var(--toggle-shift));
    transition:
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 320ms ease,
      border-color 320ms ease,
      box-shadow 320ms ease !important;
  }
  .theme-toggle-thumb .theme-toggle-icon {
    position: absolute;
    inset: 7px;
    width: calc(100% - 14px);
    height: calc(100% - 14px);
    opacity: 0;
    transform: rotate(-35deg) scale(0.72);
    transition:
      opacity 240ms ease,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .theme-toggle-thumb-moon {
    color: #f2f5ff;
  }
  .theme-toggle-thumb-sun {
    color: #d98c00;
  }
  :global(html[data-theme='dark']) .theme-toggle-thumb-moon,
  :global(html[data-theme='light']) .theme-toggle-thumb-sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  :global(html[data-theme='light']) .theme-toggle-track {
    border-color: #b9cce0;
    box-shadow:
      inset 0 1px 2px #ffffff80,
      0 7px 18px #42698724;
  }
  :global(html[data-theme='light']) .theme-toggle-track::before {
    opacity: 1;
  }
  :global(html[data-theme='light']) .theme-toggle-thumb {
    border-color: #d2d8df;
    background-color: #f4f7f9;
    box-shadow:
      0 5px 12px #4561792e,
      inset 0 1px 1px #ffffff;
    transform: translateX(0);
  }
  :global(html[data-theme='light']) .theme-toggle-track-moon,
  :global(html[data-theme='dark']) .theme-toggle-track-sun {
    opacity: 0.72;
  }
  .theme-toggle:active .theme-toggle-thumb {
    scale: 0.94;
  }
  .nav-dot {
    display: inline-block;
    height: 5px;
    width: 5px;
    background: var(--color-lime);
    border-radius: 50%;
    vertical-align: top;
    margin-top: 0.25rem;
  }
  .contact-link {
    border-bottom: 1px solid var(--color-contact-border);
  }
  @media (max-width: 760px) {
    .site-header {
      min-height: 100px;
      flex-wrap: wrap;
      padding-block: 1rem;
    }
    .brand {
      gap: 0.6rem;
    }
    .header-actions {
      margin-left: auto;
    }
    .theme-toggle {
      --toggle-width: 68px;
      --toggle-height: 36px;
      --toggle-thumb-size: 30px;
      --toggle-shift: 34px;
    }
    .theme-toggle-track > .theme-toggle-icon {
      top: 9px;
      width: 16px;
      height: 16px;
    }
    .theme-toggle-track-sun {
      left: 8px;
    }
    .theme-toggle-track-moon {
      right: 8px;
    }
    nav {
      order: 3;
      width: 100%;
      gap: 0.4rem;
      justify-content: space-between;
    }
    nav a {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.3rem;
      min-height: 44px;
      padding: 0.65rem 0.8rem;
      border-radius: 8px;
    }
    nav a[aria-current] {
      background: var(--color-surface);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle-track,
    .theme-toggle-track::before,
    .theme-toggle-thumb,
    .theme-toggle-icon {
      transition: none !important;
    }
  }
</style>
