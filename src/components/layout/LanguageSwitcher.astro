---
import { getLocale, localizedPath } from '@/lib/i18n';

const locale = getLocale(Astro.url.pathname);
// Unknown URLs must not produce links to equally missing translations.
const routes = ['/', '/playground/', '/playground/access-control/'];
const current = localizedPath(Astro.url.pathname, 'en');
const normalized = current.endsWith('/') ? current : `${current}/`;
const path = routes.includes(normalized) ? normalized : '/';
const targetLocale = locale === 'en' ? 'id' : 'en';
const label =
  locale === 'en'
    ? 'Current language: English. Switch to Indonesian.'
    : 'Bahasa saat ini: Indonesia. Beralih ke bahasa Inggris.';
---

<!-- One real link makes the entire control clickable and keeps both routes discoverable. -->
<a
  class="language-switcher"
  data-language-link
  href={localizedPath(path, targetLocale)}
  hreflang={targetLocale}
  aria-label={label}
  title={label}
>
  <span class:list={{ selected: locale === 'en' }} aria-hidden="true">EN</span>
  <span class:list={{ selected: locale === 'id' }} aria-hidden="true">ID</span>
</a>

<script>
  import '@/scripts/language-navigation';
</script>

<style>
  .language-switcher {
    display: flex;
    width: var(--header-control-width, 88px);
    height: var(--header-control-height, 44px);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 3px;
    flex-shrink: 0;
    text-decoration: none;
    color: var(--color-muted);
    font: 0.7rem var(--font-mono);
    transition: border-color 180ms ease;
  }
  .language-switcher:hover {
    border-color: var(--color-accent);
  }
  span {
    display: grid;
    place-items: center;
    flex: 1;
    min-width: 0;
    height: 100%;
    border-radius: 999px;
    color: var(--color-muted);
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  .selected {
    background: var(--color-action-background);
    color: var(--color-action-text);
  }
</style>
