---
import type { CollectionEntry } from 'astro:content';
import { localizedPath, translate, type Locale } from '@/lib/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  locale: Locale;
}
const { project, index, locale } = Astro.props;
const { data } = project;
const t = translate(locale);
---

<article class="project-card">
  <!-- Abstract artwork, not an internal application screenshot. -->
  <div class="project-art" style={`--art-hue: ${205 + index * 32}`} aria-hidden="true">
    <span class="art-label"
      >{t('Illustrative visual', 'Ilustrasi proyek')} / {String(index + 1).padStart(2, '0')}</span
    >
    <div class="art-system">
      <i></i><i></i><i></i><span>{String(index + 1).padStart(2, '0')}</span>
    </div>
    <span class="art-caption">{data.focus[locale]}</span>
  </div>
  <div class="project-copy">
    <p class="eyebrow">{data.organization}</p>
    <h3><a href={localizedPath(`/projects/${project.id}/`, locale)}>{data.title}</a></h3>
    <p class="muted">{data.summary[locale]}</p>
    <ul class="project-technologies" aria-label={t('Selected technologies', 'Teknologi utama')}>
      {data.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <a class="text-link" href={localizedPath(`/projects/${project.id}/`, locale)}>
      {t('Explore the project', 'Kenali proyek ini')}
      <span aria-hidden="true">↗</span>
      <span class="visually-hidden"> — {data.title}</span>
    </a>
  </div>
</article>

<style>
  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    background: var(--color-surface);
    box-shadow: 0 18px 45px var(--glass-shadow);
  }
  .project-art {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 195px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    color: #f1f2ed;
    background:
      radial-gradient(ellipse at 80% 20%, hsl(var(--art-hue) 40% 31%), transparent 70%), #141d2b;
  }
  .art-label,
  .art-caption {
    position: relative;
    z-index: 1;
    font: 0.65rem/1.7 var(--font-mono);
  }
  .art-label {
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .art-system {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 700px;
  }
  .art-system i {
    position: absolute;
    width: 150px;
    height: 100px;
    border: 1px solid #ffffff50;
    border-radius: 16px;
    background: #ffffff09;
    transform: translateY(-28px) rotateX(50deg) rotateZ(-30deg);
  }
  .art-system i:nth-child(2) {
    transform: rotateX(50deg) rotateZ(-30deg);
  }
  .art-system i:nth-child(3) {
    transform: translateY(28px) rotateX(50deg) rotateZ(-30deg);
  }
  .art-system > span {
    position: absolute;
    right: 1rem;
    font: 5rem/1 var(--font-mono);
    color: #ffffff16;
  }
  .project-copy {
    padding: clamp(1.2rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .project-copy .eyebrow {
    font-size: 0.62rem;
    margin-bottom: 0.7rem;
  }
  h3 {
    font-size: clamp(1.3rem, 2.5vw, 1.85rem);
    margin-bottom: 1rem;
  }
  h3 a {
    text-decoration: none;
  }
  .project-copy > .muted {
    font-size: 0.92rem;
  }
  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: auto 0 1rem;
  }
  .project-technologies li {
    border: 1px solid var(--color-border);
    border-radius: 99px;
    padding: 0.3rem 0.6rem;
    font: 0.65rem/1.5 var(--font-mono);
    color: var(--color-muted);
  }
  .text-link {
    align-self: flex-start;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
