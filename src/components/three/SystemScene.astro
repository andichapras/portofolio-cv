<system-scene>
  <figure class="system-figure" aria-labelledby="scene-caption">
    <div class="scene-top"><span>ANATOMY OF A SYSTEM</span><span class="scene-dot" aria-hidden="true"></span></div>
    <div class="scene-viewport" data-interaction role="group" aria-label="Interactive system illustration" aria-describedby="scene-gesture">
      <div data-canvas aria-hidden="true"></div>
      <!-- Keep a static illustration visible until WebGL is ready. -->
      <div class="scene-fallback" aria-hidden="true"><div>01 / Interface</div><div>02 / Business logic</div><div>03 / Data</div></div>
    </div>
    <figcaption id="scene-caption"><strong>Good systems connect the layers.</strong><span>Interface. Business logic. Data.</span></figcaption>
    <p id="scene-gesture" class="scene-gesture"><span class="pointer-hint">Drag to explore · Arrow keys to rotate</span><span class="touch-hint">Swipe sideways to rotate · Scroll vertically</span></p>
    <div class="scene-controls" aria-label="3D illustration controls"><button type="button" data-explode disabled aria-pressed="false">Separate layers</button><button type="button" data-reset disabled>Reset</button></div>
    <p class="scene-status" data-status role="status">Static preview · interactive 3D loads when available.</p>
  </figure>
</system-scene>
<script>
  class SystemSceneElement extends HTMLElement {
    private cleanup?: () => void;
    private observer?: IntersectionObserver;
    private generation = 0;
    connectedCallback() {
      // Ignore stale imports if this element disconnects while the module loads.
      const generation = ++this.generation;
      // Load the 3D bundle only when the illustration enters the viewport.
      this.observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        this.observer?.disconnect();
        import('./system-scene').then(({ mountSystemScene }) => {
          if (this.isConnected && this.generation === generation) this.cleanup = mountSystemScene(this);
        }).catch(() => {
          const status = this.querySelector('[data-status]');
          if (status) status.textContent = 'Static preview · interactive 3D is unavailable.';
        });
      });
      this.observer.observe(this);
    }
    disconnectedCallback() {
      // Release observers and GPU resources when the element leaves the page.
      this.generation++;
      this.observer?.disconnect();
      this.cleanup?.();
    }
  }
  if (!customElements.get('system-scene')) customElements.define('system-scene', SystemSceneElement);
</script>
<style>
  system-scene { display: block; min-width: 0; width: 100%; max-width: 640px; margin-inline: auto; }
  .system-figure { margin: 0; padding: 1.4rem; overflow: hidden; border: 1px solid var(--color-border); border-radius: 20px; background: radial-gradient(ellipse at 50% 40%, #24303e 0%, #14191f 65%); }
  .scene-top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; font: .6rem var(--font-mono); letter-spacing: .1em; color: var(--color-muted); }
  .scene-dot { width: 6px; height: 6px; flex-shrink: 0; background: var(--color-lime); border-radius: 50%; }
  .scene-viewport { position: relative; aspect-ratio: 1.2; min-height: 220px; border-radius: 12px; }
  :global(system-scene[data-ready]) .scene-viewport { cursor: grab; touch-action: pan-y pinch-zoom; user-select: none; -webkit-user-select: none; }
  .scene-viewport[data-dragging] { cursor: grabbing !important; }
  .scene-viewport:focus-visible { outline-offset: -3px; background: #ffffff03; }
  [data-canvas] { position: absolute; inset: 0; }
  [data-canvas] :global(canvas) { display: block; width: 100%; height: 100%; }
  .scene-fallback { position: absolute; inset: 10% 15%; display: flex; flex-direction: column; justify-content: center; gap: 14px; transform: rotate(-14deg); pointer-events: none; }
  .scene-fallback div { padding: 1.2rem; border: 1px solid #b6cdfd80; background: #26364a; border-radius: 10px; box-shadow: 10px 10px 0 #080b0f70; font: .8rem var(--font-mono); }
  .scene-fallback div:nth-child(2) { background: #425034; color: #e1f9c3; }
  .scene-fallback div:nth-child(3) { background: #30343e; }
  :global(system-scene[data-ready]) .scene-fallback { display: none; }
  figcaption strong { display: block; font-weight: 500; font-size: 1rem; }
  figcaption span { display: block; color: var(--color-muted); font-size: .8rem; margin-top: .4rem; }
  .scene-gesture { font: .65rem/1.7 var(--font-mono); color: var(--color-muted); margin: .9rem 0 0; visibility: hidden; }
  :global(system-scene[data-ready]) .scene-gesture { visibility: visible; }
  .touch-hint { display: none; }
  .scene-controls { display: flex; gap: .6rem; margin-top: 1rem; }
  .scene-controls button { padding: .65rem 1rem; border: 1px solid var(--color-border); border-radius: 8px; background: transparent; color: var(--color-text); font-size: .75rem; min-height: 44px; transition: background .2s, border-color .2s; }
  .scene-controls button[aria-pressed=true] { background: var(--color-lime); color: #14171e; }
  .scene-status { font: .6rem/1.7 var(--font-mono); color: var(--color-muted); min-height: 1.8em; margin: .8rem 0 0; }
  @media (hover: hover) {
    .scene-controls button:not(:disabled):hover { border-color: var(--color-accent); background: #b6cdfd18; }
    .scene-controls button[aria-pressed=true]:hover { background: #e2ffb0; }
  }
  @media (pointer: coarse) {
    .pointer-hint { display: none; }
    .touch-hint { display: inline; }
  }
  @media (max-width: 600px) {
    .system-figure { padding: 1.1rem; border-radius: 16px; }
    .scene-controls button { flex: 1; min-height: 48px; }
    .scene-fallback { inset-inline: 12%; }
    .scene-fallback div { padding: .9rem; font-size: .72rem; }
  }
</style>
