---
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { getPublishedProjects } from '@/lib/projects';
import { getLocale, localizedPath, translate } from '@/lib/i18n';
import '@/styles/project-carousel.css';

const locale = getLocale(Astro.url.pathname);
const t = translate(locale);
const projects = await getPublishedProjects();
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow"><span class="index">02 /</span>{t('Selected work', 'Proyek pilihan')}</p>
      <h2 id="work-title">
        {t('Real work.', 'Pengalaman nyata.')}<br />
        {t('Thoughtful solutions.', 'Solusi yang dipikirkan matang.')}
      </h2>
    </div>
    <p class="muted">
      {
        t(
          'Six projects. Different challenges. One connected perspective.',
          'Enam proyek. Beragam tantangan. Satu perspektif yang menyeluruh.',
        )
      }
    </p>
  </div>
  <div class="project-carousel" data-project-carousel>
    <div class="carousel-toolbar">
      <button
        class="button secondary"
        type="button"
        data-project-view
        aria-controls="project-stage"
        aria-pressed="false"
        hidden
      >
        {t('List view', 'Tampilan daftar')}
      </button>
      <p class="muted">
        {t('Explore the work behind my experience.', 'Kenali proyek di balik pengalaman saya.')}
      </p>
      <a class="text-link" href={localizedPath('/projects/', locale)}>
        {t('View all projects', 'Lihat semua proyek')}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="carousel-controls" data-carousel-controls hidden>
      <button
        type="button"
        data-previous
        aria-label={t('Previous project', 'Proyek sebelumnya')}
        aria-controls="project-stage">←</button
      >
      <p class="carousel-status" data-carousel-status aria-live="polite" aria-atomic="true"></p>
      <button
        type="button"
        data-next
        aria-label={t('Next project', 'Proyek berikutnya')}
        aria-controls="project-stage">→</button
      >
    </div>
    <p class="carousel-hint" id="project-hint" data-carousel-controls hidden>
      {
        t(
          'Swipe or drag to explore. Use the arrow keys when the cards are focused.',
          'Geser untuk menjelajah. Gunakan tombol panah saat area kartu mendapat fokus.',
        )
      }
    </p>
    <div
      class="project-stage"
      id="project-stage"
      data-project-stage
      aria-label={t('Project cards', 'Kartu proyek')}
    >
      {
        projects.map((project, index) => (
          <div class="project-slide" data-project-slide data-title={project.data.title}>
            <ProjectCard project={project} index={index} locale={locale} />
          </div>
        ))
      }
    </div>
    <div
      class="carousel-picker"
      data-carousel-controls
      hidden
      role="group"
      aria-label={t('Choose a project', 'Pilih proyek')}
    >
      {
        projects.map((project, index) => (
          <button
            type="button"
            data-project-picker={index}
            aria-label={project.data.title}
            aria-controls="project-stage"
          >
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '@/scripts/project-carousel';
</script>
