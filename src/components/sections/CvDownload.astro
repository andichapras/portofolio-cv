---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

// Keep this filename stable so replacing the PDF does not require a code change.
const filename = 'andicha-eka-prastya-cv.pdf';
const downloadUrl = `/cv/${filename}`;

// Checked during rendering/build, not in the visitor's browser.
const available = existsSync(resolve('public', 'cv', filename));
---

<div class="cv-download">
  {
    available ? (
      <a class="button secondary" href={downloadUrl} download={filename}>
        Download CV <span aria-hidden="true">↓</span>
      </a>
    ) : (
      <button class="button secondary" type="button" disabled>
        Download CV <span aria-hidden="true">↓</span>
      </button>
    )
  }
  <p class="muted">{available ? 'PDF · A closer look at my experience.' : 'PDF coming soon.'}</p>
</div>

<style>
  .cv-download {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }

  .cv-download p {
    margin: 0;
    font-size: 0.8rem;
  }

  @media (max-width: 600px) {
    .cv-download {
      align-items: stretch;
      flex-direction: column;
    }

    .cv-download .button {
      width: 100%;
      min-height: 48px;
    }
  }
</style>
