---
// Bun supports these Node-compatible APIs; @types/node supplies their TypeScript definitions.
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { getLocale, translate } from '@/lib/i18n';

const t = translate(getLocale(Astro.url.pathname));
interface Props {
  noteId?: string;
}
const { noteId = 'cv-view-note' } = Astro.props;

// Keep this filename stable so replacing the PDF does not require a code change.
const filename = 'andicha-eka-prastya-cv.pdf';
const downloadUrl = `/cv/${filename}`;

// Checked during rendering/build, not in the visitor's browser.
const available = existsSync(resolve('public', 'cv', filename));
---

<div class="cv-download">
  {
    available ? (
      <>
        <a
          class="button secondary"
          href={downloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-describedby={noteId}
        >
          {t('View CV', 'Lihat CV')} <span aria-hidden="true">↗</span>
        </a>
        <a class="button secondary" href={downloadUrl} download={filename}>
          {t('Download CV', 'Unduh CV')} <span aria-hidden="true">↓</span>
        </a>
      </>
    ) : (
      <button class="button secondary" type="button" disabled>
        {t('Download CV', 'Unduh CV')} <span aria-hidden="true">↓</span>
      </button>
    )
  }
  <p class="muted" id={noteId}>
    {
      available
        ? t('PDF · View opens in a new tab.', 'PDF · Pratinjau dibuka di tab baru.')
        : t('PDF coming soon.', 'PDF belum tersedia.')
    }
  </p>
</div>

<style>
  .cv-download {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }

  .cv-download p {
    margin: 0;
    font-size: 0.8rem;
  }

  @media (max-width: 600px) {
    .cv-download {
      align-items: stretch;
      flex-direction: column;
    }

    .cv-download .button {
      width: 100%;
      min-height: 48px;
    }
  }
</style>
