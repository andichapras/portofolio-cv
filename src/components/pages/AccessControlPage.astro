---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccessControlGame from '@/components/games/AccessControlGame';
import { getLocale, localizedPath, translate } from '@/lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = translate(locale);
---

<BaseLayout
  title="Access Control Challenge | Andicha Eka Prastya"
  description={t(
    'A playable access-control puzzle: configure permissions for three roles and test your policy against 27 scenarios.',
    'Teka-teki kontrol akses: atur izin untuk tiga peran dan uji aturanmu dengan 27 skenario.',
  )}
>
  <main id="main-content" class="container section" tabindex="-1">
    <a class="text-link" href={localizedPath('/playground/', locale)}
      >← {t('All experiments', 'Semua eksperimen')}</a
    >
    <header class="game-heading">
      <p class="eyebrow"><span class="index">01 /</span> Access Control Challenge</p><h1>
        {t('The right access.', 'Akses yang tepat.')}<br />{
          t('For the right people.', 'Untuk orang yang tepat.')
        }
      </h1><p class="muted">
        {
          t(
            'You’re designing permissions for a fictional branch-based system. Let legitimate work happen. Keep everything else out.',
            'Kamu merancang izin untuk sistem cabang fiktif. Izinkan pekerjaan yang sah dan cegah akses yang tidak semestinya.',
          )
        }
      </p>
    </header>
    <section class="brief" aria-labelledby="brief-title">
      <h2 id="brief-title">{t('Your mission', 'Misimu')}</h2><ul>
        <li>
          <strong>{t('Agent:', 'Agen:')}</strong>
          {
            t(
              'read and edit their own records. Never approve.',
              'membaca dan mengubah data milik sendiri. Tidak boleh menyetujui.',
            )
          }
        </li><li>
          <strong>{t('Manager:', 'Manajer:')}</strong>
          {
            t(
              'read all records in their branch. Approve other people’s records in that branch, but never their own. Never edit.',
              'membaca semua data di cabangnya. Menyetujui data orang lain di cabang tersebut, tetapi tidak boleh menyetujui data sendiri. Tidak boleh mengubah data.',
            )
          }
        </li><li>
          <strong>Auditor:</strong>
          {
            t(
              'read records across all branches. Never edit or approve.',
              'membaca data di semua cabang. Tidak boleh mengubah atau menyetujui.',
            )
          }
        </li>
      </ul><p>
        {
          t(
            '“Same branch” includes the user’s own records. Use the self-approval safeguard when scope alone is not enough.',
            '“Cabang yang sama” mencakup data milik sendiri. Gunakan pengaman persetujuan data sendiri jika cakupan akses saja belum cukup.',
          )
        }
      </p><p class="muted">
        {
          t(
            'Each role is tested for read, edit, and approve against an own record, a colleague’s record in the same branch, and a record in another branch: 27 checks in total.',
            'Setiap peran diuji untuk membaca, mengubah, dan menyetujui data sendiri, data rekan satu cabang, dan data cabang lain: total 27 pemeriksaan.',
          )
        }
      </p>
    </section>
    <noscript
      ><p class="no-script">
        {
          t(
            'This game needs JavaScript to evaluate your policy. The mission above and the rest of the portfolio remain available without it.',
            'Game ini membutuhkan JavaScript untuk mengevaluasi aturanmu. Penjelasan misi dan konten portofolio tetap dapat dibaca tanpa JavaScript.',
          )
        }
      </p></noscript
    >
    <AccessControlGame client:load locale={locale} />
    <p class="disclaimer muted">
      {
        t(
          'Educational simulation. This is not a security audit or a production authorization system. Your choices stay in this page’s memory and reset when you reload or switch language.',
          'Simulasi edukatif, bukan audit keamanan atau sistem otorisasi produksi. Pilihanmu hanya tersimpan di memori halaman dan direset saat memuat ulang atau mengganti bahasa.',
        )
      }
    </p>
  </main>
</BaseLayout>
<style>
  .game-heading {
    padding: 3rem 0 2rem;
  }
  .game-heading h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 1.08;
  }
  .game-heading > p:last-child {
    max-width: 620px;
    font-size: 1.1rem;
    margin-top: 1.5rem;
  }
  .brief {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
  }
  .brief h2 {
    font-size: 1.5rem;
  }
  .brief ul {
    padding-left: 1.2rem;
    line-height: 1.9;
  }
  .brief li {
    margin-bottom: 0.5rem;
  }
  .brief p {
    font-size: 0.9rem;
    max-width: 850px;
  }
  .disclaimer {
    font-size: 0.8rem;
    margin-top: 2rem;
    max-width: 800px;
  }
  .no-script {
    border: 1px solid var(--color-lime);
    padding: 1rem;
  }
</style>
