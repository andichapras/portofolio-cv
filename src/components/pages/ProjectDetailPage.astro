---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { getLocale, localizedPath, translate } from '@/lib/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const locale = getLocale(Astro.url.pathname);
const t = translate(locale);
const breadcrumbs = [
  { name: t('Home', 'Beranda'), path: localizedPath('/', locale) },
  { name: t('Projects', 'Proyek'), path: localizedPath('/projects/', locale) },
  { name: data.title, path: localizedPath(`/projects/${project.id}/`, locale) },
];
---

<BaseLayout
  title={`${data.title} | Andicha Eka Prastya`}
  description={data.summary[locale]}
  breadcrumbs={breadcrumbs}
>
  <main id="main-content" class="container section project-detail" tabindex="-1">
    <Breadcrumbs items={breadcrumbs} label={t('Breadcrumb', 'Jejak navigasi')} />
    <article>
      <header class="project-intro">
        <p class="eyebrow">{data.organization} / {data.role}</p>
        <h1>{data.title}</h1>
        <p class="project-lead">{data.summary[locale]}</p>
        <p class="focus">{data.focus[locale]}</p>
      </header>
      <div class="detail-grid">
        <div>
          {
            data.sections.map((section) => (
              <section class="story-section">
                <h2>{section.heading[locale]}</h2>
                <p>{section.text[locale]}</p>
              </section>
            ))
          }
        </div>
        <aside class="stack" aria-labelledby="stack-title">
          <p class="eyebrow">{t('Engineering toolkit', 'Perangkat pengembangan')}</p>
          <h2 id="stack-title">{t('Technology & scope', 'Teknologi & lingkup')}</h2>
          <dl>
            {
              data.stack.map((group) => (
                <div>
                  <dt>{group.label[locale]}</dt>
                  <dd>{group.tools}</dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>
      <div class="project-contact">
        <h2>
          {t('Let’s talk about your next challenge.', 'Mari diskusikan tantangan berikutnya.')}
        </h2>
        <a class="button" href={localizedPath('/#contact', locale)}
          >{t('Start a conversation', 'Mulai percakapan')} ↗</a
        >
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .project-intro {
    max-width: 58rem;
    padding-block: 2.5rem;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    letter-spacing: -0.045em;
  }
  .project-lead {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--color-muted);
  }
  .focus {
    color: var(--color-accent);
    font: 0.8rem/1.8 var(--font-mono);
  }
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .story-section {
    border-top: 1px solid var(--color-border);
    padding-block: 2rem 1rem;
  }
  h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.9rem);
    letter-spacing: -0.025em;
  }
  .story-section p {
    line-height: 1.9;
    color: var(--color-muted);
  }
  .stack {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 1.5rem;
  }
  .stack h2 {
    font-size: 1.3rem;
  }
  dl {
    margin-bottom: 0;
  }
  dl > div + div {
    margin-top: 1.5rem;
  }
  dt {
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }
  dd {
    margin: 0;
    color: var(--color-muted);
    font: 0.75rem/1.9 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .project-contact {
    margin-top: 3rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }
  @media (max-width: 850px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
    .project-intro {
      padding-block: 2rem;
    }
  }
</style>
