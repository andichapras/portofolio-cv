---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { getPublishedProjects } from '@/lib/projects';
import { getLocale, localizedPath, translate } from '@/lib/i18n';

const locale = getLocale(Astro.url.pathname);
const t = translate(locale);
const projects = await getPublishedProjects();
---

<BaseLayout
  pageType="CollectionPage"
  projects={projects.map((project) => ({
    name: project.data.title,
    path: localizedPath(`/projects/${project.id}/`, locale),
  }))}
  title={t('Projects | Andicha Eka Prastya', 'Proyek | Andicha Eka Prastya')}
  description={t(
    'Explore six projects across Mandiri Utama Finance and Nusantara Duta Solusindo: system analysis, full-stack engineering, integration, and delivery.',
    'Kenali enam proyek di Mandiri Utama Finance dan Nusantara Duta Solusindo: analisis sistem, pengembangan full-stack, integrasi, dan implementasi.',
  )}
>
  <main id="main-content" class="container section" tabindex="-1">
    <a class="text-link" href={localizedPath('/#work', locale)}
      >← {t('Back to home', 'Kembali ke beranda')}</a
    >
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t('Experience in practice', 'Pengalaman dalam praktik')}</p>
        <h1>{t('Projects & contributions', 'Proyek & kontribusi')}</h1>
      </div>
      <p class="muted">
        {
          t(
            'The context, the work, and my part in each project.',
            'Konteks, pekerjaan, dan peran saya dalam setiap proyek.',
          )
        }
      </p>
    </div>
    <div class="projects-grid">
      {
        projects.map((project, index) => (
          <ProjectCard project={project} index={index} locale={locale} />
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: -0.04em;
  }
  .section-heading {
    margin-top: 2rem;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 700px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
