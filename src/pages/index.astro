---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExperienceSection from "@/components/sections/ExperienceSection.astro";
import SelectedWork from "@/components/sections/SelectedWork.astro";
import SystemScene from "@/components/three/SystemScene.astro";
import { siteConfig } from "@/config/site";
import CvDownload from '@/components/sections/CvDownload.astro';
---

<BaseLayout>
  <main id="main-content" tabindex="-1">
    <section class="hero container" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow hero-label">
          <span class="signal" aria-hidden="true"></span> Software Engineer & System
          Analyst
        </p>
        <h1 id="hero-heading">
          A clear idea.<br />A thoughtful system.<br /><span
            >A better experience.</span
          >
        </h1>
        <p class="intro">
          I'm Pras. I turn business needs into connected digital
          experiences—from the first question to the final implementation.
        </p>
        <div class="hero-actions">
          <a class="button" href="#work"
            >Explore my work <span aria-hidden="true">↘</span></a
          ><a class="text-link" href="/playground/"
            >Or, play a little <span aria-hidden="true">↗</span></a
          >
        </div>
        <p class="hero-location">
          <span aria-hidden="true">◎</span> Based in Jakarta, Indonesia
        </p>
      </div>
      <SystemScene />
    </section>
    <div class="expertise-strip">
      <div class="container strip-inner">
        <span>Business understanding</span><span aria-hidden="true">+</span
        ><span>System thinking</span><span aria-hidden="true">+</span><span
          >End-to-end engineering</span
        >
      </div>
    </div>
    <div class="container">
      <SelectedWork />
      <section id="about" class="section about" aria-labelledby="about-heading">
        <div>
          <p class="eyebrow">
            <span class="index">02 /</span> Behind the build
          </p><h2 id="about-heading">
            Curious about the why.<br /><span class="muted"
              >Careful with the how.</span
            >
          </h2>
        </div>
        <div class="about-copy">
          <p>
            I work at the intersection of software engineering and system
            analysis. My work spans frontend and backend development, API
            design, integration, and translating business processes into
            technical solutions.
          </p><p class="muted">
            I enjoy connecting the dots: listening to stakeholders, making
            trade-offs explicit, and helping teams move from a requirement to a
            working system.
          </p><a class="text-link" href={siteConfig.socials.linkedin}
            >More about my background <span aria-hidden="true">↗</span></a
          >
        </div>
      </section>
      <ExperienceSection />
      <section class="lab section" aria-labelledby="lab-heading">
        <div class="lab-copy">
          <p class="eyebrow">
            <span class="index">04 /</span> A little less serious. Still engineering.
          </p><h2 id="lab-heading">
            Good systems.<br />Playful experiments.
          </h2><p>
            What if the best way to understand a system is to play with its
            rules? Step into the lab and put your engineering intuition to work.
          </p><a class="button" href="/playground/access-control/"
            >Play Access Control <span aria-hidden="true">↗</span></a
          ><p class="lab-meta">
            Interactive challenge / No sign-up / Your browser only
          </p>
        </div>
        <a
          class="lab-preview"
          href="/playground/access-control/"
          aria-label="Play Access Control Challenge"
        >
          <div class="preview-top">
            <span>ACCESS_CONTROL.EXE</span><span class="preview-status"
              >READY</span
            >
          </div>
          <div class="permission-row">
            <span>Agent</span><span class="allow">READ OWN ✓</span>
          </div>
          <div class="permission-row">
            <span>Manager</span><span class="pending">APPROVE ?</span>
          </div>
          <div class="permission-row">
            <span>Auditor</span><span class="deny">EDIT ×</span>
          </div>
          <div class="preview-bottom">
            <span
              >Who gets access?<br /><strong>You make the rules.</strong></span
            ><span class="play-icon" aria-hidden="true">↗</span>
          </div>
        </a>
      </section>
      <section
        id="contact"
        class="section contact"
        aria-labelledby="contact-heading"
      >
        <p class="eyebrow">
          <span class="index">05 /</span> Start a conversation
        </p>
        <h2 id="contact-heading">Have something<br />in mind<span>?</span></h2>
        <div class="contact-bottom">
          <p class="muted">
            An opportunity, a collaboration, or a good technical question.<br
            />I'd love to hear from you.
          </p><a class="contact-email" href={`mailto:${siteConfig.email}`}
            >{siteConfig.email} <span aria-hidden="true">↗</span></a
          >
        </div>
        <CvDownload />
        <div class="socials">
          <a href={siteConfig.socials.linkedin}>LinkedIn ↗</a><a
            href={siteConfig.socials.github}>GitHub ↗</a
          >
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 2rem;
    min-height: 700px;
    padding-block: 5rem;
  }
  .hero-label {
    color: var(--color-text);
    letter-spacing: 0.06em;
  }
  .hero-copy {
    min-width: 0;
  }
  .signal {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--color-lime);
    margin-right: 0.6rem;
    border-radius: 50%;
  }
  h1 {
    font-size: clamp(2.7rem, 4.7vw, 4.5rem);
    line-height: 1.09;
    letter-spacing: -0.055em;
    margin-block: 2rem 1.5rem;
  }
  h1 > span {
    color: var(--color-accent);
  }
  .intro {
    max-width: 45ch;
    color: var(--color-muted);
    font-size: 1rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-top: 2rem;
  }
  .hero-location {
    color: var(--color-muted);
    font: 0.7rem/1.5 var(--font-mono);
    margin-top: 3rem;
  }
  .hero-location span {
    margin-right: 0.5rem;
  }
  .expertise-strip {
    border-block: 1px solid var(--color-border);
  }
  .strip-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.6rem;
    font: 0.72rem/1.5 var(--font-mono);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .strip-inner span:nth-child(even) {
    color: var(--color-lime);
  }
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    border-top: 1px solid var(--color-border);
  }
  .about h2 {
    font-size: clamp(2rem, 3.7vw, 3.2rem);
  }
  .about-copy {
    padding-top: 2rem;
    font-size: 1.05rem;
  }
  .lab {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 4rem;
    align-items: center;
    border-top: 1px solid var(--color-border);
  }
  .lab-copy > p:not(.eyebrow) {
    max-width: 45ch;
    color: var(--color-muted);
  }
  .lab-meta {
    font: 0.63rem/1.8 var(--font-mono);
    margin: 1.3rem 0 0;
  }
  .lab-preview {
    background: #e5eccf;
    color: #24321b;
    border-radius: 14px;
    padding: 2rem;
    text-decoration: none;
    transform: rotate(2deg);
    transition: transform 0.25s;
    box-shadow: 0 20px 80px #0005;
  }
  .lab-preview:hover {
    transform: rotate(0deg) translateY(-4px);
    color: #24321b;
  }
  .preview-top,
  .permission-row,
  .preview-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }
  .preview-top {
    font: 0.65rem/1.6 var(--font-mono);
    margin-bottom: 2rem;
  }
  .preview-status {
    border: 1px solid #748766;
    border-radius: 3px;
    padding: 0.2rem 0.4rem;
  }
  .permission-row {
    border-top: 1px solid #bdc9a9;
    padding-block: 1rem;
    font-size: 0.9rem;
  }
  .permission-row > span:last-child {
    font: 0.64rem/1.5 var(--font-mono);
    padding: 0.35rem 0.55rem;
    border-radius: 3px;
  }
  .allow {
    background: #c7dfb1;
  }
  .pending {
    background: #f5e2a1;
  }
  .deny {
    background: #e8c9c0;
  }
  .preview-bottom {
    border-top: 1px solid #bdc9a9;
    padding-top: 1.5rem;
    line-height: 1.5;
    font-size: 1.1rem;
  }
  .play-icon {
    border-radius: 50%;
    background: #283b21;
    color: #eef6dd;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    font-size: 1.4rem;
  }
  .contact {
    border-top: 1px solid var(--color-border);
  }
  .contact h2 {
    font-size: clamp(3.5rem, 9vw, 8rem);
    letter-spacing: -0.065em;
    margin-block: 1.7rem 2.5rem;
  }
  .contact h2 span {
    color: var(--color-lime);
  }
  .contact-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: center;
  }
  .contact-email {
    font-size: clamp(1rem, 2vw, 1.55rem);
    overflow-wrap: anywhere;
  }
  .socials {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    font: 0.75rem/1.6 var(--font-mono);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 3.5rem;
      gap: 1rem;
    }
    h1 {
      font-size: clamp(2.6rem, 7.5vw, 4.5rem);
    }
    .hero-copy {
      max-width: 650px;
    }
    .about,
    .lab {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .lab-preview {
      max-width: 540px;
      width: 100%;
      margin-top: 1.5rem;
    }
  }
  @media (max-width: 600px) {
    .strip-inner {
      flex-wrap: wrap;
      justify-content: center;
      font-size: 0.58rem;
    }
    .strip-inner span:nth-child(even) {
      display: none;
    }
    .hero {
      padding-block: 2.5rem 2rem;
      gap: 1.5rem;
      min-height: auto;
    }
    h1 {
      font-size: clamp(2rem, 8.8vw, 3.3rem);
      margin-top: 1.5rem;
    }
    .hero-actions {
      gap: 0.75rem 1.25rem;
    }
    .hero-location {
      margin-top: 1.75rem;
      margin-bottom: 0;
    }
    .lab-preview {
      padding: 1.4rem;
      transform: none;
    }
  }
</style>
