---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import { siteConfig } from '@/config/site';
import '@/styles/global.css';
import '@/styles/navigation.css';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import { getLocale, translate, type Locale } from '@/lib/i18n';
import {
  canonicalUrl,
  createStructuredData,
  languageAlternates,
  serializeStructuredData,
  type Breadcrumb,
} from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  language?: Locale;
  noindex?: boolean;
  pageType?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
  breadcrumbs?: Breadcrumb[];
  projects?: Breadcrumb[];
}

// Pages can override metadata while keeping the shared site defaults.
const language = Astro.props.language ?? getLocale(Astro.url.pathname);
const t = translate(language);
const {
  title = t(siteConfig.title, 'Andicha Eka Prastya | Software Engineer — Analisis & Desain Sistem'),
  description = t(
    siteConfig.description,
    'Portofolio Andicha Eka Prastya, Software Engineer dengan fokus analisis kebutuhan dan desain sistem di Jakarta, Indonesia.',
  ),
  noindex = false,
  pageType = 'WebPage',
  breadcrumbs = [],
  projects = [],
} = Astro.props;
if (!Astro.site) throw new Error('Configure Astro site before rendering portfolio metadata.');
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const alternates = languageAlternates(Astro.url.pathname, Astro.site);
const socialImage = new URL('/social-preview.png', Astro.site).href;
const socialImageAlt = `${siteConfig.name} — Software Engineer. System analysis and full-stack development.`;
const structuredData = createStructuredData({
  site: Astro.site,
  pathname: Astro.url.pathname,
  language,
  title,
  description,
  pageType,
  breadcrumbs,
  projects,
});
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <!-- Keep navigation opt-in in the initial HTML, independent of stylesheet loading. -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        @view-transition {
          navigation: none;
        }
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        Object.entries(alternates).map(([hreflang, href]) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:locale" content={language === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:locale:alternate" content={language === 'id' ? 'en_US' : 'id_ID'} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {
      !noindex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializeStructuredData(structuredData)}
        />
      )
    }
    <meta name="theme-color" content="#0c0e12" data-theme-color />
    <script is:inline>
      (() => {
        const storageKey = 'portfolio-theme';
        const root = document.documentElement;
        let storedTheme = null;

        try {
          const value = localStorage.getItem(storageKey);
          if (value === 'light' || value === 'dark') storedTheme = value;
        } catch {
          // Storage can be unavailable in restrictive browsing modes.
        }

        const theme = storedTheme ?? 'dark';

        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        document
          .querySelector('[data-theme-color]')
          ?.setAttribute('content', theme === 'light' ? '#f4f6f1' : '#0c0e12');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/brand-mark.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Collect page views across every route that uses this layout. -->
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t('Skip to content', 'Lewati ke konten')}</a>
    <SiteHeader />
    <!-- Each page supplies its own main content inside the shared document shell. -->
    <slot />
    <footer class="container site-footer">
      <p>© {new Date().getFullYear()} {siteConfig.name}</p><p>
        {t('Built with curiosity.', 'Dibangun dengan rasa ingin tahu.')}
        <a href={siteConfig.socials.github}>GitHub ↗</a>
      </p>
    </footer>
    <!-- Measure real-user performance across every route. -->
    <SpeedInsights />
  </body>
</html>
