---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import { siteConfig } from '@/config/site';
import '@/styles/global.css';
import SiteHeader from '@/components/layout/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  language?: string;
}

// Pages can override metadata while keeping the shared site defaults.
const {
  title = siteConfig.title,
  description = siteConfig.description,
  language = siteConfig.language,
} = Astro.props;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0c0e12" data-theme-color />
    <script is:inline>
      (() => {
        const storageKey = 'portfolio-theme';
        const root = document.documentElement;
        let storedTheme = null;

        try {
          const value = localStorage.getItem(storageKey);
          if (value === 'light' || value === 'dark') storedTheme = value;
        } catch {
          // Storage can be unavailable in restrictive browsing modes.
        }

        const theme = storedTheme ?? 'dark';

        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        document
          .querySelector('[data-theme-color]')
          ?.setAttribute('content', theme === 'light' ? '#f4f6f1' : '#0c0e12');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/brand-mark.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Collect page views across every route that uses this layout. -->
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <!-- Each page supplies its own main content inside the shared document shell. -->
    <slot />
    <footer class="container site-footer">
      <p>© {new Date().getFullYear()} {siteConfig.name}</p><p>
        Built with curiosity. <a href={siteConfig.socials.github}>GitHub ↗</a>
      </p>
    </footer>
    <!-- Measure real-user performance across every route. -->
    <SpeedInsights />
  </body>
</html>
