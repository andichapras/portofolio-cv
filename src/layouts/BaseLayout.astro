---
import { siteConfig } from '@/config/site';
import '@/styles/global.css';
import SiteHeader from '@/components/layout/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  language?: string;
}

// Pages can override metadata while keeping the shared site defaults.
const {
  title = siteConfig.title,
  description = siteConfig.description,
  language = siteConfig.language,
} = Astro.props;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0c0e12" />
    <link rel="icon" type="image/svg+xml" href="/brand-mark.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <!-- Each page supplies its own main content inside the shared document shell. -->
    <slot />
    <footer class="container site-footer">
      <p>© {new Date().getFullYear()} {siteConfig.name}</p><p>
        Built with curiosity. <a href={siteConfig.socials.github}>GitHub ↗</a>
      </p>
    </footer>
  </body>
</html>
